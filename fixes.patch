+// Maps a virtual-key code to the character stored in the keybind string.
+// Returns '\0' for keys that can't be used as mania keys.
+static char vk_to_config_char(int vk) {
+    if (vk == VK_SPACE)
+        return ' ';
+
+    const UINT ch = MapVirtualKeyA(static_cast<UINT>(vk), MAPVK_VK_TO_CHAR) & 0x7FFFu;
+
+    if (ch >= 'A' && ch <= 'Z')
+        return static_cast<char>(ch - 'A' + 'a');
+    if ((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'z'))
+        return static_cast<char>(ch);
+
+    switch (ch) {
+        case ';': case '\'': case ',': case '.': case '/':
+        case '[': case ']': case '-': case '=': case '`': case '\\':
+            return static_cast<char>(ch);
+        default:
+            return '\0';
+    }
+}
+
+static bool validate_keys(const char *buf, std::string &err) {
+    const size_t len = std::strlen(buf);
+
+    if (len < 4) {
+        err = "Need at least 4 keys.";
+        return false;
+    }
+    if (len > 16) {
+        err = "Keep it to 16 keys max.";
+        return false;
+    }
+    if (len % 2 != 0) {
+        err = "Use an even number of keys (odd column counts add a center space automatically).";
+        return false;
+    }
+
+    bool seen[256] = {};
+    for (size_t i = 0; i < len; ++i) {
+        const unsigned char uc = static_cast<unsigned char>(buf[i]);
+        if (buf[i] == ' ' || !std::isprint(uc)) {
+            err = "Keys must be printable characters (no spaces).";
+            return false;
+        }
+        const unsigned char lower = static_cast<unsigned char>(std::tolower(uc));
+        if (seen[lower]) {
+            (err = "Duplicate key: '").push_back(static_cast<char>(lower));
+            err.push_back('\'');
+            err.push_back('.');
+            return false;
+        }
+        seen[lower] = true;
+    }
+
+    return true;
+}
